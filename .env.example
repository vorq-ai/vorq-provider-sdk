# Copy to .env (gitignored) and fill in. Source before running the daemon:
#   set -a; source .env; set +a

# REQUIRED: operator wallet key (secp256k1), used when provider.wallet_key is
# not set. The daemon refuses to start without it.
VORQ_WALLET_KEY=

# Curve25519 box key for sealed payloads, read where your config names it
# with env:VORQ_BOX_KEY.
VORQ_BOX_KEY=

# Backend API key, read where your config names it with env:BACKEND_API_KEY.
BACKEND_API_KEY=

# Only needed if you run the queue-backend example config.
QUEUE_BACKEND_KEY=
